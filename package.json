{
  "name": "ai-diagram-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format:check": "prettier --check app components lib tests playwright.config.ts vitest.config.ts"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "next": "16.4.6",
    "openai": "7.25.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.2",
    "saxes": "6.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "xmlbuilder2": "4.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "jsdom": "30.1.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
